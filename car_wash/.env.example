# Copy to .env for reference, or export these directly in your shell.
# The scripts read os.environ directly (no dotenv), so you must export them:
#   export $(grep -v '^#' .env | xargs)
# or just: export ANTHROPIC_API_KEY=...

# Required — main study (experiment.py, run_f_condition.py)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional — cross-model follow-up scripts only
# OPENAI_API_KEY=sk-xxxxxxxx
# GOOGLE_API_KEY=xxxxxxxx
